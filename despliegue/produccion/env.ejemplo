# Copiar a despliegue/produccion/.env en el servidor (chmod 600). Nunca va a git.
POSTGRES_USER=plataforma
POSTGRES_DB=plataforma
POSTGRES_PASSWORD=          # openssl rand -hex 24
CLAVE_SECRETA=              # openssl rand -hex 32
ANFITRIONES=sosgalapagos.org,plataforma,localhost
ORIGENES_CONFIABLES=https://sosgalapagos.org

# ── Avisos del navegador ── las genera desplegar.sh la primera vez (manage.py llaves_push)
PUSH_PUBLICA=
PUSH_PRIVADA=
PUSH_CONTACTO=mailto:sosgalapagos@usfq.edu.ec

# ── Modelo de lenguaje ── «proveedor:modelo»; vacío = extracción con reglas
#   IA_MODELO=anthropic:claude-haiku-5-5     + ANTHROPIC_API_KEY
#   IA_MODELO=google:gemini-3.5-flash-lite   + GOOGLE_API_KEY
IA_MODELO=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── WhatsApp (servidor OpenWA) ── ver docs/whatsapp.md
WHATSAPP_MODO=apagado           # apagado | ensayo | activo
OPENWA_URL=                     # dirección del servidor, sin /api
OPENWA_LLAVE=                   # llave de API propia de este servicio
OPENWA_SESION=                  # id de la sesión (no el nombre)
WHATSAPP_SECRETO=               # lo genera desplegar.sh; va en la dirección del webhook
WHATSAPP_CHATS=                 # chats que se atienden, separados por comas
WHATSAPP_DIRECTOS=0             # 1 = también chats privados (solo lo que pasa el filtro)
WHATSAPP_RESPONDER_EN_GRUPOS=0  # 1 = responde dentro de los grupos

# ── Clima: fuentes oficiales y del mar ── las direcciones son privadas: solo aquí, nunca en el repositorio
CLIMA_INOCAR_MAREAS_URL=        # tabla diaria de mareas, con {cp} y {fecha}
CLIMA_INOCAR_OLEAJE_RSS=
CLIMA_SNGR_SITREP_URL=          # página de los SITREP de la SNGR
CLIMA_ERFEN_URL=
CLIMA_INAMHI_ADVERTENCIA_URL=
CLIMA_INAMHI_PRONOSTICO_URL=
CLIMA_INAMHI_LLUVIA_HORAS_URL=
CLIMA_STORMGLASS_API=
CLIMA_STORMGLASS_LLAVES=        # separadas por comas; 10 llamadas al día cada una
# El Niño y la ZCIT (clima/nino.py, clima/zcit.py). Vacía: esa parte no se consulta.
CLIMA_CPC_ONI_URL=              # NOAA CPC: ONI (texto)
CLIMA_CPC_SEMANAL_URL=          # NOAA CPC: índices Niño semanales (texto)
CLIMA_CPC_MENSUAL_URL=          # NOAA CPC: índices Niño mensuales (texto)
CLIMA_CPC_CALOR_URL=            # NOAA CPC: calor de los 300 m de arriba (texto)
CLIMA_CPC_ENSO_URL=             # NOAA CPC: discusión mensual de ENSO (página)
CLIMA_CRW_ERDDAP=               # NOAA Coral Reef Watch: griddap con el identificador del conjunto, sin extensión
CLIMA_OISST_ERDDAP=             # NOAA OISST v2.1 casi en tiempo real: griddap con el identificador, sin extensión
CLIMA_SLA_ERDDAP=               # NOAA CoastWatch, nivel del mar por altimetría: griddap con el identificador
CLIMA_TAO_ERDDAP=               # boyas TAO: raíz «tabledap» del servidor ERDDAP, sin barra final
CLIMA_MJO_URL=                  # NOAA PSL: índice ROMI de la MJO (texto)
CLIMA_NHC_TWD_URL=              # NHC: Tropical Weather Discussion del Pacífico este (texto plano)
WINDY_MAPA_LLAVE=               # mapa animado (prototipo); limitada por dominio en la consola de Windy

# ── Clima: fuentes de mediciones ── direcciones y llaves; ninguna va en el repositorio.
# Una fuente sin sus variables simplemente no corre (clima/fuentes/__init__.py dice cuáles pide cada una).
CLIMA_RELEVO_LLAVE=             # la genera desplegar.sh; es la que usa la máquina de relevo de IERSE (despliegue/relevo/)
CLIMA_IERSE_API=                # IERSE-WSN. Solo responde desde Ecuador: entra por el relevo
CLIMA_IERSE_DIRECTO=            # 1 solo si este servidor puede hablar con IERSE directamente
CLIMA_GSC_WS=                   # GSC-USFQ
CLIMA_GSC_ORIGEN=
CLIMA_INAMHI_API=               # INAMHI, estaciones automáticas
CLIMA_IOC_API=                  # mareógrafos
CLIMA_METAR_API=                # aeropuertos
CLIMA_WEATHERLINK_API=
CLIMA_WEATHERLINK_ESTACIONES=   # identificador_del_mapa:código[,…]
CLIMA_RESPALDO_ERNA_API=
CLIMA_TEMPEST_API=
CLIMA_TEMPEST_TOKEN=
CLIMA_TEMPEST_EQUIPOS=          # identificador_del_equipo:código[,…]
CLIMA_AMBIENT_API=
CLIMA_AMBIENT_ESTACIONES=       # clave_del_enlace:código[,…]
CLIMA_WU_PAGINA=
CLIMA_WU_ESTACIONES=            # identificador_de_la_estación:código[,…]
CLIMA_OPENMETEO_FORECAST_API=   # modelos de pronóstico
CLIMA_OPENMETEO_ENSEMBLE_API=
CLIMA_OPENMETEO_MARINE_API=     # modelo del mar
CLIMA_GOES_S3=                  # raíz del archivo abierto del satélite GOES-19
CLIMA_GIBS_WMTS=                # NASA GIBS: raíz WMTS EPSG:3857 «best», sin barra final (fondo GeoColor del mapa del satélite)
CLIMA_PDIRNOW_URL=              # PDIR-Now (CHRS, UC Irvine): carpeta de los archivos horarios, sin barra final ni año

# ── Portada (sosgalapagos.org/) ──
# Carpeta del servidor con los informes en PDF y su indice.json; se monta de solo lectura en /srv/descargas.
DESCARGAS_DIR=/srv/sosgalapagos-descargas
# Correo para ejercer derechos sobre datos personales (página /privacidad).
PRIVACIDAD_CORREO=jamaya@usfq.edu.ec
